# AllOfGithubLanguages — explicit GitHub Linguist overrides
# Put this file at the REPOSITORY ROOT as: .gitattributes
#
# Important:
# GitHub's sidebar still shows only the largest few languages and groups the
# rest under "Other". These rules make the sample files count correctly;
# they cannot force GitHub's sidebar to print 50+ separate rows.

# Do NOT let repository metadata dominate the language statistics
README.md linguist-detectable=false
.gitattributes linguist-detectable=false
.gitignore linguist-detectable=false
.gitignore.example linguist-detectable=false
LICENSE linguist-detectable=false

# Explicit language mapping for every sample file
